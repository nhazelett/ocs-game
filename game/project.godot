; Engine configuration file. Open with Godot 4.6 .NET.
config_version=5

[application]
config/name="OCS: Lines of Support"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=960
window/size/min_height=600
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="LinesOfSupport.Game"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12, 0.12, 0.12, 1)
