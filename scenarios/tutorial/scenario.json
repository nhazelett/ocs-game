  "briefing": {
    "title": "Your first week at the hub",
    "situation": "You're the contracting officer for the hub on the main island, three hundred people, already open. The host nation runs the power, the fuel point, the water point and the honey trucks; billeting and dining run on a blanket purchase agreement the last rotation set up.",
    "due": "Nothing is on fire yet. Requests will come to you as the week goes, and the outgoing contracting officer is here for your first three days."
  },
  "turnover": {
    "from": "mills",
    "shop": "Here's the shop.",
    "contracts": "Most of what keeps the hub running is the host nation's. Billeting and dining are calls on our camp BPA.",
    "vendorList": "These are the vendors I've used, and a couple I know by name.",
    "money": "Last, the money. There's enough; the cash box is the thing to watch.",
    "remarks": {
      "arrangements": {
        "hubWaterPoint": "The water point's been down since last week; the host nation says day 9."
      },
      "vendors": {
        "harborEquipment": "We have a BPA with Harbor Equipment for forklifts and the like. They've always answered.",
        "islandMart": "Island Mart takes the card. Harbor Bottling is cash only."
      },
      "fundingLines": {}
    }
  },
  "prepBriefing": {
    "from": "cole",
    "intro": "You have fourteen days before wheels up. Here's what you can get done from here. You can't do all of it, so pick what you'll miss least on the ground.",
    "choices": {
      "gpcAccounts": "Purchase cards take about five days to set up from home. Out there, they take weeks.",
      "cashAndPayingAgent": "Finance can line up a paying agent and cash for you now, or you can find them when you land.",
      "systemAccess": "Get your contract-writing system account started now and it may be working when you arrive.",
      "templatesAndKit": "Bring templates and a paper kit, and the manual work goes faster until the system's up."
    },
    "defaults": [
      "gpcAccounts",
      "cashAndPayingAgent",
      "systemAccess"
    ]
  },
