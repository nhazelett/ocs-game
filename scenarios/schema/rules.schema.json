{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocs-game/schema/rules.schema.json",
  "title": "OCS: Lines of Support rules file (v0)",
  "description": "Rules shared across scenarios: thresholds, instrument parameters, consequence curves, model constants. Versioned; every save records the version it was played under. Money is integer cents. Days are integers. Fractions are 0 to 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rulesVersion",
    "asOf",
    "thresholds",
    "uca",
    "instruments",
    "prepChoices",
    "aggregateRates",
    "model",
    "sco"
  ],
  "properties": {
    "schemaVersion": {
      "const": 0
    },
    "rulesVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}(\\.[0-9]+)?$",
      "description": "Year-month of the regulatory baseline, optional patch, e.g. 2025-10 or 2025-10.1"
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "microPurchaseCents",
        "simplifiedAcquisitionCents",
        "basis"
      ],
      "properties": {
        "microPurchaseCents": {
          "type": "integer",
          "minimum": 0
        },
        "simplifiedAcquisitionCents": {
          "type": "integer",
          "minimum": 0
        },
        "basis": {
          "type": "string",
          "description": "Which threshold set this is, e.g. 'contingency, outside the United States, FAR 2.101 effective 2025-10-01'"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "uca": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligationCapBeforeProposal",
        "obligationCapAfterProposal",
        "definitizeWithinDays",
        "definitizeAtObligatedFraction",
        "approvalLagDays",
        "definitizationShopDays",
        "qualifyingProposalLagDays",
        "stopWorkAfterUnpaidDays",
        "hhqInquiryAfterOverdueDays",
        "defaultNtePermilleOfQuote"
      ],
      "properties": {
        "obligationCapBeforeProposal": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "obligationCapAfterProposal": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "definitizeWithinDays": {
          "type": "integer",
          "minimum": 1
        },
        "definitizeAtObligatedFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "approvalLagDays": {
          "$ref": "#/$defs/intRange"
        },
        "definitizationShopDays": {
          "$ref": "#/$defs/intRange"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "qualifyingProposalLagDays": {
          "$ref": "#/$defs/intRange",
          "description": "Days from issuance to the vendor's qualifying proposal, unless the vendor overrides it"
        },
        "stopWorkAfterUnpaidDays": {
          "type": "integer",
          "minimum": 1
        },
        "hhqInquiryAfterOverdueDays": {
          "type": "integer",
          "minimum": 0
        },
        "defaultNtePermilleOfQuote": {
          "type": "integer",
          "minimum": 1000
        }
      }
    },
    "instruments": {
      "type": "object",
      "description": "One entry per instrument id. Keys are the instrument ids the sim knows.",
      "additionalProperties": false,
      "required": [
        "sf44",
        "gpc",
        "purchaseOrder",
        "bpaEstablish",
        "bpaCall",
        "idiqEstablish",
        "idiqOrder",
        "uca",
        "acsa",
        "hostNation",
        "externalSupport",
        "coordination"
      ],
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9]*$": {
          "$ref": "#/$defs/instrument"
        }
      }
    },
    "prepChoices": {
      "type": "array",
      "description": "Pre-deployment window choices (SPEC 4.2).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "prepDays",
          "effects"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string"
          },
          "prepDays": {
            "type": "integer",
            "minimum": 0
          },
          "effects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/effect"
            },
            "minItems": 1
          }
        }
      }
    },
    "aggregateRates": {
      "type": "object",
      "description": "Daily event probabilities with a front-loaded decay: p(day) = floor + (start - floor) * 0.5^(day / halfLifeDays). Placeholders until playtesting (Nick, 7 Nov 2026).",
      "additionalProperties": false,
      "required": [
        "paymentErrorManual",
        "executionConfusionNoTerms",
        "bpaCallDeclineBase",
        "vendorWillingnessDecayPerLatePayment"
      ],
      "properties": {
        "paymentErrorManual": {
          "$ref": "#/$defs/decayCurve"
        },
        "executionConfusionNoTerms": {
          "$ref": "#/$defs/decayCurve"
        },
        "bpaCallDeclineBase": {
          "$ref": "#/$defs/decayCurve"
        },
        "vendorWillingnessDecayPerLatePayment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "defaultBufferDays",
        "missionWeights",
        "hoursPerPersonPerDay",
        "manualContractTimeFactor",
        "infoTiers",
        "failure",
        "work",
        "supplyLineSizingPermille",
        "cashReplenishThresholdPermille",
        "executionConfusionMinDurationDays",
        "downThresholdPermille",
        "invoiceIntervalDays"
      ],
      "properties": {
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "unit",
              "demandPerPersonPerDay",
              "dependsOn",
              "delivery",
              "lines"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "demandPerPersonPerDay": {
                "type": "number",
                "minimum": 0
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "description": "Capability ids whose coverage gates this one's effective supply (e.g. power depends on fuel)"
              },
              "usualOwner": {
                "type": "string",
                "description": "Who normally arranges this capability for a deployed site, in plain words for the dependency checklist (design doc R10; fuel: the J4 through the ACSA partner or DLA Energy). Absent: the contracting office buys it."
              },
              "delivery": {
                "enum": [
                  "continuous",
                  "consumable"
                ],
                "description": "continuous: installed capacity (power, lodging). consumable: delivered and buffered (fuel, water, food); off-island suppliers deliver only on surface-link run days."
              },
              "lines": {
                "type": "array",
                "description": "Scope lines for this capability's requirement card (seed of the card catalog). core: supplies this capability. supplies: also supplies another capability at the site. operator, maintenance: their absence raises daily failure risk.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "kind"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "label": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "core",
                        "supplies",
                        "operator",
                        "maintenance"
                      ]
                    },
                    "supplies": {
                      "$ref": "#/$defs/id"
                    }
                  }
                }
              }
            }
          }
        },
        "defaultBufferDays": {
          "type": "number",
          "minimum": 0
        },
        "missionWeights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sortieGeneration",
            "throughput",
            "endurance",
            "resilience"
          ],
          "properties": {
            "sortieGeneration": {
              "type": "number",
              "minimum": 0
            },
            "throughput": {
              "type": "number",
              "minimum": 0
            },
            "endurance": {
              "type": "number",
              "minimum": 0
            },
            "resilience": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "hoursPerPersonPerDay": {
          "type": "number",
          "minimum": 1
        },
        "manualContractTimeFactor": {
          "type": "number",
          "minimum": 1,
          "description": "Multiplier on written-action shop time while no contract-writing system is online"
        },
        "infoTiers": {
          "type": "array",
          "items": {
            "enum": [
              "assumed",
              "estimated",
              "surveyed",
              "observed"
            ]
          },
          "minItems": 4,
          "maxItems": 4
        },
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "missingOperatorPermillePerDay",
            "missingMaintenancePermillePerDayAfterGrace",
            "missingMaintenanceGraceDays",
            "missingMaintenanceCapPermille",
            "continuousFailureSupplyPermille"
          ],
          "properties": {
            "missingOperatorPermillePerDay": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "missingMaintenancePermillePerDayAfterGrace": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "missingMaintenanceGraceDays": {
              "type": "integer",
              "minimum": 0
            },
            "missingMaintenanceCapPermille": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "continuousFailureSupplyPermille": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "description": "Share of rated supply still delivered on a failure day for continuous capabilities"
            }
          }
        },
        "work": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "surveyShopHours",
            "surveyReturnDays",
            "ratificationShopDays",
            "paymentErrorReworkHours",
            "hhqInquiryResponseHours",
            "terminationShopDays"
          ],
          "properties": {
            "surveyShopHours": {
              "type": "integer",
              "minimum": 0
            },
            "surveyReturnDays": {
              "type": "integer",
              "minimum": 0
            },
            "ratificationShopDays": {
              "type": "integer",
              "minimum": 0
            },
            "paymentErrorReworkHours": {
              "type": "integer",
              "minimum": 0
            },
            "hhqInquiryResponseHours": {
              "type": "integer",
              "minimum": 0
            },
            "terminationShopDays": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "supplyLineSizingPermille": {
          "type": "integer",
          "minimum": 1000,
          "description": "A 'supplies' line is sized by the vendor to the peak demand of the supplied capability over the period, times this"
        },
        "cashReplenishThresholdPermille": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "executionConfusionMinDurationDays": {
          "type": "integer",
          "minimum": 1,
          "description": "Arrangements without written terms that run at least this long roll the execution-confusion curve daily"
        },
        "downThresholdPermille": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "invoiceIntervalDays": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sco": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responseLagDaysByResponsiveness",
        "terminationShopDayFactorWithGuidance",
        "disputeProbabilityWithoutGuidance",
        "disputeProbabilityWithGuidance",
        "jointBoardsStandupDays",
        "jointBoardsRequirementLagDays"
      ],
      "properties": {
        "responseLagDaysByResponsiveness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "high",
            "medium",
            "low"
          ],
          "properties": {
            "high": {
              "$ref": "#/$defs/intRange"
            },
            "medium": {
              "$ref": "#/$defs/intRange"
            },
            "low": {
              "$ref": "#/$defs/intRange"
            }
          }
        },
        "terminationShopDayFactorWithGuidance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "disputeProbabilityWithoutGuidance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "disputeProbabilityWithGuidance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "jointBoardsStandupDays": {
          "$ref": "#/$defs/intRange"
        },
        "jointBoardsRequirementLagDays": {
          "$ref": "#/$defs/intRange"
        }
      }
    },
    "unauthorized": {
      "type": "object",
      "additionalProperties": false,
      "description": "Unauthorized commitments: handshake patience, walk-off, parked-ratification inquiry, out-of-scope work, unit precedent (SPEC 4.5). Permille values are 0 to 1000.",
      "required": [
        "patienceDays",
        "walkOffDeclinePermille",
        "walkOffMarkupPermille",
        "parkedInquiryAfterDays",
        "parkedInquiryResponseHours",
        "ratifiedBridgeDays",
        "outOfScopeDenyShopHours",
        "habitStartPermille",
        "habitRiseParkOrRefusePermille",
        "habitRiseLongOpenPermille",
        "habitLongOpenDays",
        "habitDropQuickRatifyPermille",
        "quickRatifyWithinDays",
        "habitRiseOutOfScopeRatifyPermille",
        "habitCapPermille"
      ],
      "properties": {
        "patienceDays": {
          "$ref": "#/$defs/intRange",
          "description": "Days a handshake vendor keeps delivering unpaid before it walks off (SPEC 4.5)"
        },
        "walkOffDeclinePermille": {
          "type": "integer",
          "minimum": 0
        },
        "walkOffMarkupPermille": {
          "type": "integer",
          "minimum": 0
        },
        "parkedInquiryAfterDays": {
          "type": "integer",
          "minimum": 0
        },
        "parkedInquiryResponseHours": {
          "type": "integer",
          "minimum": 0
        },
        "ratifiedBridgeDays": {
          "type": "integer",
          "minimum": 0
        },
        "outOfScopeDenyShopHours": {
          "type": "integer",
          "minimum": 0
        },
        "habitStartPermille": {
          "type": "integer",
          "minimum": 0
        },
        "habitRiseParkOrRefusePermille": {
          "type": "integer",
          "minimum": 0
        },
        "habitRiseLongOpenPermille": {
          "type": "integer",
          "minimum": 0
        },
        "habitLongOpenDays": {
          "type": "integer",
          "minimum": 0
        },
        "habitDropQuickRatifyPermille": {
          "type": "integer",
          "minimum": 0
        },
        "quickRatifyWithinDays": {
          "type": "integer",
          "minimum": 0
        },
        "habitRiseOutOfScopeRatifyPermille": {
          "type": "integer",
          "minimum": 0
        },
        "habitCapPermille": {
          "type": "integer",
          "minimum": 0
        },
        "sourceUrl": {
          "type": "string"
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Vendor under-delivery and cure notices (FAR 49.402-3; backlog M2-18). Permille values are 0 to 1000.",
      "required": [
        "underDeliveryDays",
        "windowDays",
        "cureNoticeShopHours",
        "cureDays",
        "cureRecoverPermille",
        "curedReliabilityPermille",
        "defaultReliabilityDropPermille"
      ],
      "properties": {
        "underDeliveryDays": {
          "type": "integer",
          "minimum": 0
        },
        "windowDays": {
          "type": "integer",
          "minimum": 0
        },
        "cureNoticeShopHours": {
          "type": "integer",
          "minimum": 0
        },
        "cureDays": {
          "type": "integer",
          "minimum": 0
        },
        "cureRecoverPermille": {
          "type": "integer",
          "minimum": 0
        },
        "curedReliabilityPermille": {
          "type": "integer",
          "minimum": 0
        },
        "defaultReliabilityDropPermille": {
          "type": "integer",
          "minimum": 0
        },
        "sourceUrl": {
          "type": "string"
        }
      }
    },
    "cor": {
      "type": "object",
      "additionalProperties": false,
      "description": "COR report lag and fidelity by quality (DFARS 201.602-2; backlog M3-04). Permille values are 0 to 1000.",
      "required": [
        "qualities",
        "noCorLagDays",
        "reliefQuality"
      ],
      "properties": {
        "qualities": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lagDays",
              "reportPermille"
            ],
            "properties": {
              "lagDays": {
                "type": "integer",
                "minimum": 0
              },
              "reportPermille": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            }
          }
        },
        "noCorLagDays": {
          "type": "integer",
          "minimum": 0,
          "description": "With no COR, a failure is reported only when it shows as a mission effect, by the unit, this many days later."
        },
        "reliefQuality": {
          "type": "string",
          "description": "Quality of the untrained relief when a COR rotates home; a key of qualities."
        },
        "sourceUrl": {
          "type": "string"
        }
      }
    },
    "lift": {
      "type": "object",
      "additionalProperties": false,
      "description": "Strategic lift for off-island sourcing (SPEC 4.1; backlog M3-06): airlift queue and bumping, sealift transit, customs hold on arrival at the port of entry.",
      "properties": {
        "airliftQueueDays": {
          "$ref": "#/$defs/intRange"
        },
        "airliftBumpChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "airliftBumpDelayDays": {
          "$ref": "#/$defs/intRange"
        },
        "airliftMaxBumps": {
          "type": "integer",
          "minimum": 0
        },
        "sealiftTransitDays": {
          "$ref": "#/$defs/intRange"
        },
        "customsHoldChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "customsHoldDays": {
          "$ref": "#/$defs/intRange"
        },
        "notes": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "description": "Transition plans between arrangements (SPEC 2 and 4; backlog M3-05): the default overlap and how far ahead the planner flags a gap.",
      "properties": {
        "defaultOverlapDays": {
          "type": "integer",
          "minimum": 1,
          "description": "Days the incoming arrangement must deliver at full before the outgoing one is cut over, when a plan does not say."
        },
        "warnDays": {
          "type": "integer",
          "minimum": 0,
          "description": "The planner flags a projected gap on the morning board once the outgoing arrangement ends within this many days."
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "fileReview": {
      "type": "object",
      "additionalProperties": false,
      "description": "Reviewing the inherited contract files (backlog M3-17): what it costs the shop. The findings come in when the work is done.",
      "properties": {
        "hoursPerArrangement": {
          "type": "number",
          "minimum": 0,
          "description": "Shop hours per inherited contract file reviewed."
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "description": "Vendor claims after a termination without the contract's notice (backlog M3-19, FAR 49).",
      "properties": {
        "settleShopHours": {
          "type": "number",
          "minimum": 0,
          "description": "Shop hours to settle one claim."
        },
        "settlementDays": {
          "type": "integer",
          "minimum": 0,
          "description": "The settlement in days of the arrangement's daily cost, capped at the days of performance cut short."
        },
        "notes": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        }
      }
    },
    "smallBuys": {
      "type": "object",
      "additionalProperties": false,
      "description": "The customer small-buy stream that consumes shop hours every day (design doc 6.1). 13 milli-buys per person per day puts a 300-person hub near four buys a day.",
      "required": [
        "buysPerPersonPerDayMilli",
        "hoursEachMilli",
        "complainAfterHeldDays"
      ],
      "properties": {
        "buysPerPersonPerDayMilli": {
          "type": "integer",
          "minimum": 0
        },
        "hoursEachMilli": {
          "type": "integer",
          "minimum": 0
        },
        "complainAfterHeldDays": {
          "type": "integer",
          "minimum": 1
        },
        "customerUnit": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        }
      }
    },
    "gpcProgram": {
      "type": "object",
      "additionalProperties": false,
      "description": "Standing up a decentralized purchase card program diverts most small buys off the shop (design doc 6.1).",
      "required": [
        "standUpShopHours",
        "divertedPermille"
      ],
      "properties": {
        "standUpShopHours": {
          "type": "integer",
          "minimum": 0
        },
        "divertedPermille": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "sourceUrl": {
          "type": "string"
        }
      }
    },
    "goingToPeople": {
      "type": "object",
      "additionalProperties": false,
      "description": "Going to people (design doc 6.2, 6.2a): shop-hour costs and what each visit returns.",
      "properties": {
        "notes": {
          "type": "string"
        },
        "findFinance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shopHours",
            "payingAgentWithinDays",
            "replenishLagDays"
          ],
          "properties": {
            "shopHours": {
              "type": "integer",
              "minimum": 0
            },
            "payingAgentWithinDays": {
              "type": "integer",
              "minimum": 0
            },
            "replenishLagDays": {
              "type": "integer",
              "minimum": 0
            },
            "sourceUrl": {
              "type": "string"
            }
          }
        },
        "staffMeeting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "joinShopHours",
            "weeklyShopHours",
            "everyDays",
            "previewDays"
          ],
          "properties": {
            "joinShopHours": {
              "type": "integer",
              "minimum": 0
            },
            "weeklyShopHours": {
              "type": "integer",
              "minimum": 0
            },
            "everyDays": {
              "type": "integer",
              "minimum": 1
            },
            "previewDays": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "askSco": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shopHours",
            "questions"
          ],
          "properties": {
            "shopHours": {
              "type": "integer",
              "minimum": 0
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label"
                ],
                "properties": {
                  "id": {
                    "enum": [
                      "fuel",
                      "routes",
                      "vehicles",
                      "thresholds"
                    ]
                  },
                  "label": {
                    "type": "string"
                  },
                  "tutorialDirection": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "meetVendor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shopHours",
            "confidence"
          ],
          "properties": {
            "shopHours": {
              "type": "integer",
              "minimum": 0
            },
            "confidence": {
              "enum": [
                "assumed",
                "estimated",
                "surveyed",
                "observed"
              ]
            }
          }
        },
        "engageJ4": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shopHours",
            "lagDays"
          ],
          "properties": {
            "shopHours": {
              "type": "integer",
              "minimum": 0
            },
            "lagDays": {
              "type": "integer",
              "minimum": 0
            },
            "sourceUrl": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_-]*$"
    },
    "intRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "decayCurve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "floor",
        "halfLifeDays"
      ],
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "halfLifeDays": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "binding",
        "writtenTerms",
        "shopDays",
        "startLagDays",
        "requiresPayingAgent",
        "requiresSystemOrManual",
        "maxActionCents",
        "limitBasis"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "binding": {
          "type": "boolean",
          "description": "False for BPAs and coordinations: the other party may decline or withdraw"
        },
        "writtenTerms": {
          "type": "boolean",
          "description": "False for SF 44 and GPC: services run on these roll the execution-confusion curve"
        },
        "shopDays": {
          "$ref": "#/$defs/intRange",
          "description": "Shop-days of work to create or use the instrument; multiplied by manualContractTimeFactor when written and no system is online"
        },
        "startLagDays": {
          "$ref": "#/$defs/intRange",
          "description": "Calendar days from action to the arrangement being able to deliver, excluding vendor lead time"
        },
        "requiresPayingAgent": {
          "type": "boolean"
        },
        "requiresSystemOrManual": {
          "type": "boolean",
          "description": "True for written instruments"
        },
        "maxActionCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Hard cap per action; null means governed by limitBasis or none"
        },
        "limitBasis": {
          "enum": [
            "none",
            "microPurchase",
            "simplifiedAcquisition",
            "vehicleScope",
            "nte",
            "partnerStock",
            "agreement"
          ]
        },
        "obligatesMinimumGuaranteeFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "IDIQ: fraction of estimated value obligated at award as the minimum guarantee"
        },
        "declineProbabilityBase": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Non-binding instruments: base chance a call is declined; scaled by market tempo and vendor reliability"
        },
        "withdrawalNoticeDays": {
          "$ref": "#/$defs/intRange",
          "description": "Non-binding instruments: notice given when the other party walks away"
        },
        "approvalLagDays": {
          "$ref": "#/$defs/intRange",
          "description": "For instruments needing an approver (UCA via SCO, external support via SCO and higher)"
        },
        "mobilizationDays": {
          "$ref": "#/$defs/intRange",
          "description": "External support: contractor mobilization after award"
        },
        "minimumUsefulDurationDays": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "effect": {
      "type": "object",
      "description": "A typed state change. The sim implements each 'kind'. Kept open-ended in v0; the Sim rejects kinds it does not know.",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "value": {},
        "days": {
          "type": "integer"
        },
        "fraction": {
          "type": "number"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
