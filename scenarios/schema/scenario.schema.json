{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocs-game/schema/scenario.schema.json",
  "title": "OCS: Lines of Support scenario file (v0)",
  "description": "An authored skeleton plus variation ranges. Fixed situations never vary by seed. Money is integer cents; days are integers counted from day 1 (day 0 is the pre-deployment window). All ids are unique within their array and referenced by id elsewhere.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "rulesVersion",
    "days",
    "prepDays",
    "islands",
    "transportLinks",
    "sites",
    "requirementCards",
    "vendors",
    "vehicles",
    "fundingLines",
    "shop",
    "actors",
    "events",
    "fixedSituations",
    "variation",
    "passCriteria",
    "modelAssumptions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 0
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "description": "One paragraph in the SKELETONS.md form"
    },
    "rulesVersion": {
      "type": "string",
      "description": "Must match a rules file's rulesVersion"
    },
    "days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 400
    },
    "prepDays": {
      "type": "integer",
      "minimum": 0,
      "description": "Budget for the pre-deployment window (SPEC 4.2)"
    },
    "defaultSeed": {
      "type": "integer",
      "minimum": 0
    },
    "islands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "isHub"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "isHub": {
            "type": "boolean"
          },
          "grid": {
            "type": "boolean",
            "description": "Grid power present (hidden until surveyed unless infoTier says otherwise)"
          },
          "fuelPoint": {
            "type": "boolean"
          },
          "waterSource": {
            "enum": [
              "none",
              "well",
              "municipal",
              "desalination"
            ]
          },
          "infoTier": {
            "$ref": "#/$defs/infoTier",
            "description": "How well the player knows this island's facts on day 1"
          }
        }
      }
    },
    "transportLinks": {
      "type": "array",
      "description": "Directed or undirected links between islands. A vendor on island X delivering to a site on island Y needs a link; the link's schedule and weather sensitivity gate deliveries.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "mode",
          "capacityPerTrip",
          "scheduleDays",
          "weatherSensitive"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "from": {
            "$ref": "#/$defs/id"
          },
          "to": {
            "$ref": "#/$defs/id"
          },
          "bidirectional": {
            "type": "boolean",
            "default": true
          },
          "mode": {
            "enum": [
              "barge",
              "aircraft",
              "road",
              "sealift",
              "airlift"
            ]
          },
          "capacityPerTrip": {
            "type": "number",
            "minimum": 0,
            "description": "Abstract cargo units per trip"
          },
          "scheduleDays": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "description": "Days of the week the link runs (1 = day 1 of the scenario, repeating weekly). Empty means on demand."
          },
          "weatherSensitive": {
            "type": "boolean"
          },
          "priorityBumpable": {
            "type": "boolean",
            "description": "Airlift and sealift: higher-priority cargo can displace deliveries"
          }
        }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "island",
          "opensDay",
          "population",
          "capabilities"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "island": {
            "$ref": "#/$defs/id"
          },
          "opensDay": {
            "type": "integer",
            "minimum": 0
          },
          "closesDay": {
            "type": "integer",
            "minimum": 1
          },
          "population": {
            "type": "array",
            "minItems": 1,
            "description": "Step function: count applies from day onward",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "day",
                "count"
              ],
              "properties": {
                "day": {
                  "type": "integer",
                  "minimum": 0
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "tempo": {
            "type": "number",
            "minimum": 0,
            "default": 1,
            "description": "Demand multiplier on top of population"
          },
          "capabilities": {
            "type": "array",
            "description": "Which capabilities this site needs, with optional buffer override and mission criticality",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "bufferDays": {
                  "type": "number",
                  "minimum": 0
                },
                "critical": {
                  "type": "boolean",
                  "default": false
                },
                "initialArrangements": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/id"
                  },
                  "description": "Arrangement ids (from inheritedArrangements) covering this on day 1"
                },
                "initialBufferDays": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Consumables on hand when the site opens, in days of opening demand"
                }
              }
            }
          }
        }
      }
    },
    "requirementCards": {
      "type": "array",
      "description": "Requirements as cards (SPEC 2, 'Scope without paperwork'). Lines are switches; an off line is a gap the player may notice.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "site",
          "capability",
          "submittedDay",
          "requestedStartDay",
          "durationDays",
          "lines"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "site": {
            "$ref": "#/$defs/id"
          },
          "capability": {
            "$ref": "#/$defs/id"
          },
          "submittedDay": {
            "type": "integer",
            "minimum": 0
          },
          "requestedStartDay": {
            "type": "integer",
            "minimum": 0
          },
          "durationDays": {
            "type": "integer",
            "minimum": 1
          },
          "quantityHint": {
            "type": "string",
            "description": "What the unit wrote, e.g. '6 x 60 kW generators'"
          },
          "lines": {
            "type": "object",
            "description": "Scope line id to on/off. Line ids come from the capability card catalog (cards.json, M1).",
            "additionalProperties": {
              "type": "boolean"
            },
            "minProperties": 1
          },
          "submittedBy": {
            "type": "string",
            "description": "Free-text submitter; used only when the card names no person"
          },
          "flaggedEnduring": {
            "type": "boolean",
            "default": false
          },
          "person": {
            "$ref": "#/$defs/id",
            "description": "The people[] id of who brings the requirement (M2R-01)"
          },
          "message": {
            "type": "string",
            "description": "What that person says when they bring it, in their words"
          }
        },
        "anyOf": [
          {
            "required": [
              "person"
            ]
          },
          {
            "required": [
              "submittedBy"
            ]
          }
        ]
      }
    },
    "vendors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "island",
          "offers",
          "reliability",
          "acceptsGpc",
          "acceptsCash",
          "infoTier"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "island": {
            "$ref": "#/$defs/id"
          },
          "offers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "capability",
                "lines",
                "capacityPerDay",
                "leadTimeDays",
                "unitPriceCents"
              ],
              "properties": {
                "capability": {
                  "$ref": "#/$defs/id"
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Which scope lines this vendor can deliver (turnkey vendors list all)"
                },
                "capacityPerDay": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Shared across every site this vendor serves"
                },
                "leadTimeDays": {
                  "type": "integer",
                  "minimum": 0
                },
                "unitPriceCents": {
                  "type": "integer",
                  "minimum": 0
                },
                "mobilizationFraction": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2,
                  "description": "One-time mobilization cost incurred on the start day, as a fraction of the base price over the period"
                },
                "sourceIsland": {
                  "$ref": "#/$defs/id",
                  "description": "Island the consumable stock ships from when it is not the vendor's own (a local reseller that stocks from the hub). Deliveries then ride the surface links from that island; a survey of the site's island shows it."
                }
              }
            }
          },
          "reliability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "True daily reliability; the directory shows an estimate per infoTier"
          },
          "acceptsGpc": {
            "type": "boolean"
          },
          "gpcSurchargeFraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0
          },
          "acceptsCash": {
            "type": "boolean"
          },
          "vetted": {
            "type": "boolean",
            "default": false
          },
          "infoTier": {
            "$ref": "#/$defs/infoTier"
          },
          "qualifyingProposalLagDays": {
            "$ref": "#/$defs/intRange"
          },
          "vehicleOnly": {
            "type": "boolean",
            "default": false,
            "description": "Reachable only through its vehicles (no open-market award)"
          },
          "lift": {
            "type": "array",
            "items": {
              "enum": [
                "airlift",
                "sealift"
              ]
            },
            "uniqueItems": true,
            "description": "Off-island (stateside or regional) supplier: strategic lift modes it ships by to its island, the port of entry (M3-06). Absent or empty means a local vendor"
          }
        }
      }
    },
    "vehicles": {
      "type": "array",
      "description": "Existing BPAs, IDIQs and external support contracts available on day 1 (or discoverable through the SCO)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "vendor",
          "scopeTags",
          "orderingPeriodEndDay",
          "visibleOnDay1"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "bpa",
              "idiq",
              "externalSupport"
            ]
          },
          "vendor": {
            "$ref": "#/$defs/id"
          },
          "scopeTags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Scope line ids this vehicle covers; a call outside them is a hard stop"
          },
          "ceilingCents": {
            "type": "integer",
            "minimum": 0
          },
          "obligatedCents": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "callLimitCents": {
            "type": "integer",
            "minimum": 0
          },
          "orderingPeriodEndDay": {
            "type": "integer",
            "minimum": 0
          },
          "placeOfPerformance": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "Island ids; empty means anywhere in the scenario"
          },
          "ownedByOtherService": {
            "type": "boolean",
            "default": false
          },
          "visibleOnDay1": {
            "type": "boolean"
          }
        }
      }
    },
    "inheritedArrangements": {
      "type": "array",
      "description": "Arrangements already running on day 1 (sustainment and drawdown scenarios)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "instrument",
          "vendor",
          "site",
          "capability",
          "lines",
          "startDay",
          "endDay"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "instrument": {
            "$ref": "#/$defs/id"
          },
          "vendor": {
            "$ref": "#/$defs/id"
          },
          "vehicle": {
            "$ref": "#/$defs/id"
          },
          "site": {
            "$ref": "#/$defs/id"
          },
          "capability": {
            "$ref": "#/$defs/id"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startDay": {
            "type": "integer"
          },
          "endDay": {
            "type": "integer"
          },
          "noticeDays": {
            "type": "integer",
            "minimum": 0,
            "description": "Termination notice the contract requires (M3-19): a terminate action withNotice ends performance this many days after the termination is done; without notice it ends at once and the vendor files a claim (rules claims). Ignored on host nation support"
          },
          "ucaState": {
            "type": "object",
            "description": "An inherited UCA's state (M3-16): obligatedCents is what was obligated before day 1 and counts toward the NTE caps and the definitization trigger; issuedDay may be zero or negative.",
            "additionalProperties": false,
            "required": [
              "nteCents",
              "obligatedCents",
              "issuedDay",
              "qualifyingProposalDay",
              "definitized"
            ],
            "properties": {
              "nteCents": {
                "type": "integer",
                "minimum": 0
              },
              "obligatedCents": {
                "type": "integer",
                "minimum": 0
              },
              "issuedDay": {
                "type": "integer"
              },
              "qualifyingProposalDay": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "definitized": {
                "type": "boolean"
              },
              "quotedTotalCents": {
                "type": "integer",
                "minimum": 0,
                "description": "The price definitization settles at; absent means the daily cost over the whole period of performance (M3-16)"
              }
            }
          },
          "cor": {
            "$ref": "#/$defs/id"
          },
          "visibleProblem": {
            "type": "boolean",
            "default": true,
            "description": "False for the inherited problems nobody noticed (past-due UCA, ceiling nearly hit, a vendor's real delivery record): kept out of the views until a file review (reviewFiles action) or, for a past-due UCA, a higher-HQ inquiry finds them (M3-17). Not allowed on host nation support, which has no contract file to review"
          },
          "reportedReliability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The delivery record the handover reported, shown instead of the vendor's true reliability until the file is reviewed (M3-17). Only with visibleProblem false"
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Units per day; absent means the vendor's capacity for the capability (M3-16)"
          },
          "dailyCostCents": {
            "type": "integer",
            "minimum": 0,
            "description": "Cost per day of performance; absent means quantity times the vendor's unit price, zero for host nation support (M3-16)"
          },
          "obligatedCents": {
            "type": "integer",
            "minimum": 0,
            "description": "Obligated for performance from day 1 on and already counted against fundingLine; a UCA's earlier obligations go in ucaState.obligatedCents (M3-16)"
          },
          "fundingLine": {
            "$ref": "#/$defs/id",
            "description": "The funding line the arrangement is funded from; an undefinitized UCA obligates from it as it incurs (M3-16)"
          }
        }
      }
    },
    "fundingLines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "amountCents",
          "availableDay",
          "expiresDay"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "type": {
            "enum": [
              "OM"
            ]
          },
          "amountCents": {
            "type": "integer",
            "minimum": 0
          },
          "availableDay": {
            "type": "integer",
            "minimum": 0
          },
          "expiresDay": {
            "type": "integer",
            "minimum": 1
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "Capabilities the line is certified for (its purpose); absent or empty means any. Paying another capability from it is a hard stop (M3-03)."
          }
        }
      }
    },
    "cors": {
      "type": "array",
      "description": "Contracting officer's representatives the units have nominated (DFARS 201.602-2; backlog M3-04). When present, a vendor failure on a contract this office awarded with written terms reaches the office only as a COR report (lag and fidelity set by quality) or, with no COR, as a unit report of the mission effect. Absent or empty: every failure is seen the day it happens.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "quality"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string",
            "description": "Unit that nominated the COR (text only)"
          },
          "quality": {
            "type": "string",
            "description": "A key of rules cor.qualities"
          }
        }
      }
    },
    "people": {
      "type": "array",
      "description": "The cast (M2R-01, docs/design/opening-and-guidance.md 5): who brings work, hands over the shop, answers questions and runs the money. Ids are references only and never shown to the player.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "rank",
          "unit",
          "role"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Given name and surname as shown, e.g. 'Ana Ruiz'"
          },
          "rank": {
            "type": "string",
            "description": "Rank or title abbreviation as shown, e.g. 'Capt', 'MSgt', 'Mr.'; empty for none"
          },
          "unit": {
            "type": "string",
            "description": "Unit or company as shown, e.g. '3 CES'"
          },
          "role": {
            "enum": [
              "customer",
              "outgoingCco",
              "scoStaff",
              "finance",
              "commander",
              "vendorRep"
            ]
          },
          "portrait": {
            "type": "string",
            "description": "Art key for the portrait"
          },
          "vendor": {
            "$ref": "#/$defs/id",
            "description": "vendorRep only: the vendor this person works for"
          },
          "site": {
            "$ref": "#/$defs/id",
            "description": "Where the person is posted, when it matters"
          },
          "lines": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Moment key (greeting, farewell, ...) to a short line in this person's voice"
          }
        }
      }
    },
    "briefing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "situation",
        "due"
      ],
      "description": "The opening (M2R-02): who you are, where you are, what is due. Prose in a voice, no bullets (R9).",
      "properties": {
        "title": {
          "type": "string",
          "description": "One line, e.g. 'First seventy-two hours on the main island'"
        },
        "situation": {
          "type": "string"
        },
        "due": {
          "type": "string"
        }
      }
    },
    "turnover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from"
      ],
      "description": "What the outgoing CCO says at the turnover (M2R-02, design doc 3.2). Section remarks open each paragraph; per-item remarks follow that item. What the outgoing CCO believes: never name a hidden problem (M3-17).",
      "properties": {
        "from": {
          "$ref": "#/$defs/id",
          "description": "people[] id with role outgoingCco"
        },
        "shop": {
          "type": "string"
        },
        "contracts": {
          "type": "string"
        },
        "vendorList": {
          "type": "string"
        },
        "money": {
          "type": "string"
        },
        "remarks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "arrangements": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Inherited arrangement id to remark"
            },
            "vendors": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Vendor id to remark"
            },
            "fundingLines": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Funding line id to remark"
            }
          }
        }
      }
    },
    "prepBriefing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "intro"
      ],
      "description": "The pre-deployment window as a message from a person (M2R-02, design doc 3.1).",
      "properties": {
        "from": {
          "$ref": "#/$defs/id",
          "description": "people[] id of who sends it"
        },
        "intro": {
          "type": "string"
        },
        "choices": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Rules prep choice id to what this person says about it"
        },
        "defaults": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "description": "Prep choice ids shown preselected; must fit prepDays"
        }
      }
    },
    "shop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "people",
        "systemOnlineDay",
        "cashOnHandCents",
        "gpcAvailableDay",
        "payingAgentAvailableDay"
      ],
      "properties": {
        "people": {
          "type": "integer",
          "minimum": 1
        },
        "systemOnlineDay": {
          "type": "integer",
          "minimum": 0,
          "description": "Contract-writing system available from this day; prep choices can move it earlier"
        },
        "cashOnHandCents": {
          "type": "integer",
          "minimum": 0
        },
        "cashReplenishLagDays": {
          "type": "integer",
          "minimum": 0,
          "default": 5
        },
        "gpcAvailableDay": {
          "type": [
            "integer",
            "null"
          ],
          "description": "null means not set up; a prep choice or a 10 to 20 day work item makes it available"
        },
        "gpcSinglePurchaseCents": {
          "type": "integer",
          "minimum": 0
        },
        "gpcMonthlyCents": {
          "type": "integer",
          "minimum": 0
        },
        "payingAgentAvailableDay": {
          "type": [
            "integer",
            "null"
          ]
        },
        "warrantCents": {
          "type": [
            "integer",
            "null"
          ],
          "description": "null means sufficient for the scenario"
        }
      }
    },
    "actors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sco",
        "fm",
        "commander"
      ],
      "properties": {
        "sco": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "responsiveness",
            "offersJointBoardsUnprompted"
          ],
          "properties": {
            "responsiveness": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "offersJointBoardsUnprompted": {
              "type": "boolean"
            },
            "knownVehicles": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "description": "Vehicle ids returned on a reach-back ask"
            },
            "person": {
              "$ref": "#/$defs/id",
              "description": "people[] id with role scoStaff"
            }
          }
        },
        "fm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "certificationLagDays"
          ],
          "properties": {
            "certificationLagDays": {
              "type": "integer",
              "minimum": 0
            },
            "person": {
              "$ref": "#/$defs/id",
              "description": "people[] id with role finance"
            }
          }
        },
        "commander": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "priorityOrder"
          ],
          "properties": {
            "priorityOrder": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "description": "Site ids in priority order when capacity is short"
            },
            "person": {
              "$ref": "#/$defs/id",
              "description": "people[] id with role commander"
            }
          }
        },
        "hostNation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agreementExists"
          ],
          "properties": {
            "agreementExists": {
              "type": "boolean"
            },
            "reliability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.9
            },
            "name": {
              "type": "string",
              "description": "Generic host nation name shown to the player (no real nation is named)"
            },
            "island": {
              "$ref": "#/$defs/id",
              "description": "Island the host nation supplies from; absent means the requesting site's island"
            },
            "capacity": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              },
              "description": "Capability id to units per day the agreement provides, shared by every host nation support request on the same days (M3-06). Inherited hostNation arrangements are not counted against it"
            },
            "unitPriceCents": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              },
              "description": "Capability id to the shop's cost share per unit per day; absent or 0 means no cost to the shop and no funding line"
            },
            "sites": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "description": "Sites the agreement covers; empty or absent means every site"
            }
          }
        },
        "acsaPartner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "stock": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              },
              "description": "Capability id to units per day the partner can spare, shared by every ACSA order on the same days (a daily ceiling, not a depleting pool; docs/assumptions.md)"
            },
            "name": {
              "type": "string",
              "description": "Generic partner name shown to the player (no real nation is named)"
            },
            "island": {
              "$ref": "#/$defs/id",
              "description": "Island the partner supplies from; absent means the ordering site's island"
            },
            "unitPriceCents": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              },
              "description": "Capability id to reimbursable price per unit per day"
            },
            "reliability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.97
            }
          }
        },
        "externalSupport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "offers"
          ],
          "description": "The external support contract the OCS seat can request through the SCO (M3-05, SPEC 4.1). Absent: none exists. Price is a scenario parameter; no real program is named (docs/assumptions.md).",
          "properties": {
            "provider": {
              "type": "string",
              "description": "Generic provider name shown to the player"
            },
            "offers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "capability",
                  "lines",
                  "capacityPerDay",
                  "unitPriceCents"
                ],
                "properties": {
                  "capability": {
                    "$ref": "#/$defs/id"
                  },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "description": "Lines the contractor provides; a request must include the core, operator and maintenance ones (self-managed)"
                  },
                  "capacityPerDay": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unitPriceCents": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Price per unit per day"
                  },
                  "mobilizationFraction": {
                    "type": "number",
                    "minimum": 0,
                    "default": 0,
                    "description": "Mobilization as a fraction of the task order's base cost"
                  },
                  "reliability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.97
                  },
                  "sites": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/id"
                    },
                    "description": "Site ids the contract can cover; empty or absent means any"
                  }
                }
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "description": "Authored event chains. Each fires once in its window when preconditions hold, applies effects, and may schedule follow-ons. Seeded: the exact day is drawn from the window.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "window",
          "preconditions",
          "effects"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string"
          },
          "window": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "earliestDay",
              "latestDay"
            ],
            "properties": {
              "earliestDay": {
                "type": "integer",
                "minimum": 0
              },
              "latestDay": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "preconditions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/predicate"
            }
          },
          "effects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/effect"
            },
            "minItems": 1
          },
          "followOns": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "Event ids whose windows start when this fires"
          },
          "fixed": {
            "type": "boolean",
            "default": false,
            "description": "Fires on earliestDay regardless of seed"
          },
          "playerVisibleAs": {
            "type": "string",
            "description": "Inbox text when it fires, if any"
          },
          "from": {
            "$ref": "#/$defs/id",
            "description": "people[] id of who the player hears it from (M2R-01); absent for weather or a notice"
          }
        }
      }
    },
    "fixedSituations": {
      "type": "array",
      "description": "Ids (events, requirement cards, vendors) that variation must not touch",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "variation": {
      "type": "array",
      "description": "Seeded ranges applied over the skeleton. path is a JSON pointer into this file.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "kind": {
            "enum": [
              "intRange",
              "numberRange",
              "choice",
              "boolean",
              "shuffle"
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "choices": {
            "type": "array"
          },
          "probabilityTrue": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "passCriteria": {
      "type": "array",
      "description": "What 'good' looks like. The harness checks these across seeds and policies.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "metric",
          "comparator",
          "value"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string"
          },
          "metric": {
            "type": "string",
            "description": "A metric id the sim emits, e.g. 'site.spokeB.power.downDays'"
          },
          "comparator": {
            "enum": [
              "<=",
              ">=",
              "==",
              "<",
              ">"
            ]
          },
          "value": {
            "type": "number"
          }
        }
      }
    },
    "modelAssumptions": {
      "type": "array",
      "description": "Shown to the player in the assumptions panel",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_-]*$"
    },
    "infoTier": {
      "enum": [
        "assumed",
        "estimated",
        "surveyed",
        "observed"
      ]
    },
    "predicate": {
      "type": "object",
      "description": "A typed condition on state. The Sim implements each kind and rejects unknown ones.",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "comparator": {
          "enum": [
            "<=",
            ">=",
            "==",
            "<",
            ">",
            "exists",
            "notExists"
          ]
        },
        "value": {},
        "days": {
          "type": "integer"
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "value": {},
        "days": {
          "type": "integer"
        },
        "fraction": {
          "type": "number"
        },
        "note": {
          "type": "string"
        },
        "daysRange": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "Seeded alternative to days: drawn once per session from the events stream. Wins over days when both are given."
        },
        "forecastDays": {
          "type": "integer",
          "minimum": 1,
          "description": "link.closed only: when the link's non-hub island has been surveyed, a forecast record appears this many days before the closure."
        }
      }
    },
    "intRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
